PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_TIMEZONE=America/Santiago
# Configurar con scripts/configure-join-code-encryption.ps1.
# No pegar claves reales en este archivo versionado.
JOIN_CODE_ENCRYPTION_KEYS=
JOIN_CODE_KEY_VERSION=

DB_SERVER=poli-redi-server.database.windows.net
DB_PORT=1433
DB_NAME=poli-redi-database
DB_USER=poli-redi-admin
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_ISSUER=

# Temporal para pruebas locales sin Microsoft Entra ID.
# No activar en produccion.
DEV_AUTH_ENABLED=false

# Optional alternative to the DB_* variables above:
# AZURE_SQL_CONNECTION_STRING=server=poli-redi-server.database.windows.net;user id=poli-redi-admin;password=;port=1433;database=poli-redi-database;encrypt=true;trustservercertificate=false;
