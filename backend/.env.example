# API local
PORT=3000
APP_TIMEZONE=America/Santiago
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEV_AUTH_ENABLED=true
MVP_SCOPE=mvp1

# PostgreSQL 16 local. Reemplaza los valores change-me en backend/.env.
# DATABASE_URL tiene precedencia sobre las variables PG*.
DATABASE_URL=postgres://poliredi_app:change-me-local-only@localhost:55432/poliredi?sslmode=disable
PGHOST=localhost
PGPORT=55432
PGDATABASE=poliredi
PGUSER=poliredi_app
PGPASSWORD=change-me-local-only
PGSSLMODE=disable

# Bootstrap del contenedor local. El propietario solo aplica migraciones;
# la API usa siempre poliredi_app, que no es superusuario.
POSTGRES_DB=poliredi
POSTGRES_OWNER_PASSWORD=change-me-owner-local-only
POSTGRES_APP_PASSWORD=change-me-local-only
POSTGRES_PORT=55432
